# ============================================
# Sari-Sari Store POS — Environment Variables
# ============================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to git.
# ============================================

# ── App ──
APP_NAME=Sari-Sari Store POS
APP_ENV=development
DEBUG=True

# ── Server ──
HOST=0.0.0.0
PORT=5000

# ── Security (CHANGE THESE IN PRODUCTION) ──
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string

# ── Database ──
DB_TYPE=sqlite
DB_PATH=data/sari_sari_pos.db

# ── CORS (only used in production) ──
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Logging ──
LOG_LEVEL=INFO

# ── Rate Limiting ──
RATELIMIT_ENABLED=True